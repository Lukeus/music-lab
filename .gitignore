# gitignore for music lab project

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Build outputs
dist/
build/
out/

# Cache directories
.cache/
.parcel-cache/
.next/
.nuxt/

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
logs
*.log

# Audio working files (keep published audio in assets/audio/)
*.wav
*.aiff
*.flac
temp-audio/
working-sessions/

# Temporary files
*.tmp
*.temp

# Archive files
*.zip
*.tar.gz
*.rar

# Backup files
*.backup
*.bak
