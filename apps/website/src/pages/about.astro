---
// src/pages/about.astro
import Base from '../layouts/base.astro';
import ParallaxBackground from '../components/ParallaxBackground.astro';
import CinematicBackground from '../components/CinematicBackground.astro';
---

<Base
  title="About Lukeus | Music Producer & Songwriter"
  description="Learn about Lukeus, the indie artist creating experimental music from Portland, OR. From acoustic storytelling to electronic transformation, discover the journey behind the music."
  keywords="Lukeus, indie artist, music producer, songwriter, Portland music, experimental music, acoustic, electronic, music philosophy, creative process, Delancey Street, Logic Pro, UAD plugins"
  ogTitle="About Lukeus - Meet the Musician Behind the Magic"
  ogDescription="Discover the artist who transforms dreams into sound. From acoustic storytelling to electronic innovation, explore the philosophy and process behind experimental music from Portland, Oregon."
  ogImage="https://lukeus.app/assets/images/lukeus-hero-about.png"
  ogType="profile"
  ogUrl="https://lukeus.app/about"
  canonicalUrl="https://lukeus.app/about"
>
  <ParallaxBackground />
  <CinematicBackground />

  <header>
    <div class="container">
      <div class="header-content">
        <span class="logo">Because Music Matters</span>
        <nav class="nav-links">
          <a href="/" class="nav-link">🏠 Home</a>
          <a href="/tools" class="nav-link">🎹 Tools</a>
          <a href="/journal" class="nav-link">📝 Journal</a>
        </nav>
        <a href="/" class="logo" id="logo-text">Music Lab</a>
      </div>
    </div>
  </header>

  <section class="about-hero">
    <div class="hero-background-elements">
      <div class="floating-note note-1">♪</div>
      <div class="floating-note note-2">♫</div>
      <div class="floating-note note-3">♬</div>
      <div class="floating-note note-4">♩</div>
      <div class="floating-note note-5">♪</div>
      <div class="floating-note note-6">♫</div>
    </div>
    <div class="container">
      <div class="about-hero-content">
        <div class="hero-badge">
          <div class="badge-glow"></div>
          <span class="badge-icon">👨‍🎤</span>
          <span class="badge-text">Meet the Artist</span>
        </div>

        <div class="hero-image-section">
          <div class="hero-image-container">
            <div class="image-frame">
              <img
                src="/assets/images/lukeus-hero-about.png"
                alt="Lukeus - Music Producer and Songwriter surrounded by musical notes"
                class="hero-image"
                width="800"
                height="600"
                loading="eager"
              />
              <div class="image-glow"></div>
            </div>
            <div class="hero-image-overlay"></div>
            <div class="image-decorations">
              <div class="decoration decoration-1"></div>
              <div class="decoration decoration-2"></div>
              <div class="decoration decoration-3"></div>
            </div>
            <!-- Enhanced Effects Elements -->
            <div class="ambient-light"></div>
            <div class="magnetic-lines"></div>
          </div>
        </div>

        <div class="hero-text">
          <h1 class="hero-title">
            <span class="title-highlight">Meet</span>
            <span class="title-main">Lukeus</span>
          </h1>
          <div class="hero-subtitle-container">
            <div class="subtitle-line"></div>
            <p class="hero-subtitle">Musician • Artist • Dreamer • Creator</p>
            <div class="subtitle-line"></div>
          </div>
          <p class="hero-description">
            Turning dreams into reality through sound, one note at a time. From the heart of
            <span class="location-highlight">Portland, OR</span>, creating music that bridges the gap between
            <span class="emphasis">feeling</span> and <span class="emphasis">vibration</span>.
          </p>

          <div class="hero-cta">
            <a href="#spotify-section" class="hero-cta-primary">
              <span class="cta-icon">🎵</span>
              <span>Explore My Music</span>
              <div class="cta-glow"></div>
            </a>
            <a href="#artist-story" class="hero-cta-secondary">
              <span class="cta-icon">📖</span>
              <span>My Journey</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="artist-story" id="artist-story">
    <div class="container">
      <h2 class="section-title">
        <div class="section-icon" aria-hidden="true">🎵</div>
        <span>The Musical Journey</span>
      </h2>
      <div class="story-content">
        <div class="story-card main-story">
          <h3>Where Dreams Meet Sound</h3>
          <p>
            "We want things in this world to be perfect, perfected, and not to contain any flaws. To live in that
            reality of perfection, we must live in our dreams and to live in our dreams, we must be dreamers."
          </p>
          <p>
            This philosophy drives every song I create. Music became my way of translating the intangible—emotions,
            dreams, moments of clarity—into something others can feel and understand. Each track is a piece of that
            perfect world I'm building, note by note.
          </p>
        </div>

        <div class="story-cards-grid">
          <div class="story-card">
            <div class="story-icon">🎸</div>
            <h4>Acoustic Foundation</h4>
            <p>
              It all starts with just me and my acoustic guitar, letting stories flow through freestyle lyrics. 98% of
              what comes out is pure emotion meeting vibration—no plan, just truth.
            </p>
          </div>

          <div class="story-card">
            <div class="story-icon">🎛️</div>
            <h4>Electronic Evolution</h4>
            <p>
              Taking those raw acoustic stories and reimagining them through electronic lenses. Same heart, completely
              different energy. Logic Pro and UAD plugins help me discover what wants to emerge.
            </p>
          </div>

          <div class="story-card">
            <div class="story-icon">🌟</div>
            <h4>Creative Transformation</h4>
            <p>
              From struggling with purpose to finding it in sound. Delancey Street taught me that teaching is as
              important as learning, and discipline creates freedom—wisdom that lives in every song.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="spotify-section" id="spotify-section">
    <div class="container">
      <h2 class="section-title">
        <div class="section-icon" aria-hidden="true">🎧</div>
        <span>Follow the Journey</span>
      </h2>
      <div class="spotify-content">
        <div class="spotify-intro">
          <p class="spotify-description">
            Experience the full spectrum of my musical exploration on Spotify. From soulful acoustic pieces to quirky
            EDM dance tracks, each song represents a different facet of the journey from feeling to sound.
          </p>
          <div class="follow-encouragement">
            <p>🎵 Hit that follow button and join thousands of dreamers on this sonic adventure</p>
          </div>
        </div>

        <div class="spotify-embed-container">
          <iframe
            data-testid="embed-iframe"
            style="border-radius:12px"
            src="https://open.spotify.com/embed/artist/3NckmpFR1r92wBscpnbVXl?utm_source=generator"
            width="100%"
            height="352"
            frameborder="0"
            allowfullscreen=""
            allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
            loading="lazy"
            title="Lukeus on Spotify"
          >
          </iframe>
        </div>

        <div class="spotify-cta">
          <a
            href="https://open.spotify.com/artist/3NckmpFR1r92wBscpnbVXl?si=pNvmFrLvTFGIBu0KTAYlqQ"
            class="spotify-follow-btn"
            target="_blank"
            rel="noopener"
          >
            <span class="spotify-icon">🎵</span>
            <span>Follow on Spotify</span>
            <span class="arrow">→</span>
          </a>
          <p class="follow-benefits">Get notified of new releases, exclusive tracks, and behind-the-scenes content</p>
        </div>
      </div>
    </div>
  </section>

  <section class="music-philosophy">
    <div class="container">
      <h2 class="section-title">
        <div class="section-icon" aria-hidden="true">💫</div>
        <span>The Sound Philosophy</span>
      </h2>
      <div class="philosophy-grid">
        <div class="philosophy-card">
          <div class="philosophy-quote">"There's an instant correlation between sound and being understood."</div>
          <p>
            When the right combination of notes hits, when freestyle lyrics flow with emotion—that's when music
            transcends technique and becomes pure connection.
          </p>
        </div>

        <div class="philosophy-card">
          <div class="philosophy-quote">"The goal isn't perfection—it's discovery."</div>
          <p>
            Every session is about building from bass lines and beats, layering textures until something unexpected
            emerges. The imperfections make it real.
          </p>
        </div>

        <div class="philosophy-card">
          <div class="philosophy-quote">"Music is dreaming solutions into existence."</div>
          <p>
            Just like fighting nightmares by becoming the superhero in dreams, music transforms fear into melody and
            struggle into rhythm.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="connect-section">
    <div class="container">
      <h2 class="section-title">
        <div class="section-icon" aria-hidden="true">🌐</div>
        <span>Connect & Follow</span>
      </h2>
      <div class="connect-content">
        <p class="connect-intro">
          Join the creative journey across all platforms. Each space offers a different window into the process—from raw
          studio sessions to finished tracks.
        </p>
        <div class="social-grid">
          <a
            href="https://open.spotify.com/artist/3NckmpFR1r92wBscpnbVXl?si=pNvmFrLvTFGIBu0KTAYlqQ"
            class="social-card spotify"
            target="_blank"
            rel="noopener"
          >
            <div class="social-icon">🎵</div>
            <div class="social-info">
              <h4>Spotify</h4>
              <p>Latest releases & curated playlists</p>
            </div>
            <div class="social-arrow">→</div>
          </a>

          <a href="https://soundcloud.com/lukeusmusic" class="social-card soundcloud" target="_blank" rel="noopener">
            <div class="social-icon">🎧</div>
            <div class="social-info">
              <h4>SoundCloud</h4>
              <p>Experimental tracks & works in progress</p>
            </div>
            <div class="social-arrow">→</div>
          </a>

          <a href="https://www.instagram.com/musiclukeus/" class="social-card instagram" target="_blank" rel="noopener">
            <div class="social-icon">📸</div>
            <div class="social-info">
              <h4>Instagram</h4>
              <p>Behind-the-scenes & creative process</p>
            </div>
            <div class="social-arrow">→</div>
          </a>
        </div>
      </div>
    </div>
  </section>

  <footer>
    <div class="container">
      <div class="social-links">
        <a
          href="https://open.spotify.com/artist/3NckmpFR1r92wBscpnbVXl?si=pNvmFrLvTFGIBu0KTAYlqQ"
          class="social-link"
          target="_blank"
          rel="noopener"
          aria-label="Open Lukeus on Spotify">Spotify</a
        >
        <a
          href="https://soundcloud.com/lukeusmusic"
          class="social-link"
          target="_blank"
          rel="noopener"
          aria-label="Open Lukeus on SoundCloud">SoundCloud</a
        >
        <a
          href="https://www.instagram.com/musiclukeus/"
          class="social-link"
          target="_blank"
          rel="noopener"
          aria-label="Open Lukeus on Instagram">Instagram</a
        >
      </div>

      <!-- Share this page section -->
      <div class="page-share">
        <!-- ShareLinks component will populate this container -->
      </div>

      <p>&copy; 2025 Lukeus. All dreams are works in progress.</p>
    </div>
  </footer>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "AboutPage",
      "@id": "https://lukeus.app/about#aboutpage",
      "url": "https://lukeus.app/about",
      "name": "About Lukeus - Music Producer & Songwriter",
      "description": "Learn about Lukeus, the indie artist creating experimental music from Portland, OR. From acoustic storytelling to electronic transformation, discover the journey behind the music.",
      "mainEntity": {
        "@type": "Person",
        "@id": "https://lukeus.app/about#person",
        "name": "Lukeus",
        "alternateName": "Luke Adams",
        "description": "Indie artist, music producer, and creative experimenter based in Portland, Oregon. Creating everything from acoustic storytelling to electronic transformations.",
        "url": "https://lukeus.app/about",
        "image": {
          "@type": "ImageObject",
          "url": "https://lukeus.app/assets/images/lukeus-hero-about.png",
          "width": 800,
          "height": 600,
          "caption": "Lukeus - Music Producer and Songwriter surrounded by musical notes"
        },
        "sameAs": [
          "https://open.spotify.com/artist/3NckmpFR1r92wBscpnbVXl",
          "https://soundcloud.com/lukeusmusic",
          "https://www.instagram.com/musiclukeus/",
          "https://lukeus.com/",
          "https://lukeus.art/"
        ],
        "jobTitle": ["Music Producer", "Singer-Songwriter", "Electronic Music Artist", "Sound Designer"],
        "genre": ["Electronic", "Acoustic", "Experimental", "Indie", "EDM"],
        "homeLocation": {
          "@type": "Place",
          "name": "Portland, Oregon",
          "addressCountry": "US"
        },
        "knowsAbout": [
          "Music Production",
          "Sound Design",
          "Electronic Music",
          "Acoustic Guitar",
          "Logic Pro",
          "UAD Plugins",
          "Freestyle Vocals",
          "Creative Process",
          "Music Theory",
          "Songwriting"
        ],
        "hasOccupation": {
          "@type": "Occupation",
          "name": "Music Producer",
          "occupationalCategory": "Arts, Design, Entertainment, Sports, and Media Occupations",
          "skills": "Music Production, Sound Engineering, Songwriting, Performance, Electronic Music, Acoustic Music"
        }
      },
      "about": {
        "@type": "Thing",
        "name": "Music Production and Creative Process",
        "description": "Experimental music creation process from acoustic storytelling to electronic transformation"
      },
      "mentions": [
        {
          "@type": "MusicGroup",
          "name": "Lukeus",
          "sameAs": "https://open.spotify.com/artist/3NckmpFR1r92wBscpnbVXl"
        },
        {
          "@type": "SoftwareApplication",
          "name": "Logic Pro"
        },
        {
          "@type": "Place",
          "name": "Portland, Oregon"
        },
        {
          "@type": "Organization",
          "name": "Delancey Street"
        }
      ],
      "inLanguage": "en-US",
      "dateModified": "2025-01-20",
      "publisher": {
        "@type": "Organization",
        "name": "Lukeus Music Lab",
        "url": "https://lukeus.app/"
      }
    }
  </script>
</Base>

<style>
  /* About Page Styles */
  .about-hero {
    position: relative;
    min-height: 90vh;
    display: flex;
    align-items: center;
    padding: 100px 0 60px 0;
    background: radial-gradient(
      ellipse at center top,
      rgba(124, 210, 255, 0.15) 0%,
      rgba(163, 255, 176, 0.1) 30%,
      rgba(255, 187, 124, 0.05) 60%,
      transparent 100%
    );
    overflow: hidden;
  }

  .hero-background-elements {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
    z-index: 1;
  }

  .floating-note {
    position: absolute;
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    color: rgba(124, 210, 255, 0.1);
    animation: floatNote 8s ease-in-out infinite;
    pointer-events: none;
  }

  .note-1 {
    top: 15%;
    left: 10%;
    animation-delay: 0s;
  }
  .note-2 {
    top: 25%;
    right: 15%;
    animation-delay: 1s;
  }
  .note-3 {
    top: 60%;
    left: 8%;
    animation-delay: 2s;
  }
  .note-4 {
    top: 70%;
    right: 12%;
    animation-delay: 3s;
  }
  .note-5 {
    top: 40%;
    left: 85%;
    animation-delay: 4s;
  }
  .note-6 {
    top: 80%;
    left: 75%;
    animation-delay: 5s;
  }

  @keyframes floatNote {
    0%,
    100% {
      transform: translateY(0) rotate(0deg);
      opacity: 0.1;
    }
    25% {
      transform: translateY(-20px) rotate(5deg);
      opacity: 0.15;
    }
    50% {
      transform: translateY(-10px) rotate(-3deg);
      opacity: 0.1;
    }
    75% {
      transform: translateY(-30px) rotate(8deg);
      opacity: 0.2;
    }
  }

  .about-hero-content {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    max-width: 900px;
    margin: 0 auto;
    align-items: center;
    text-align: center;
  }

  .hero-badge {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(124, 210, 255, 0.2);
    border-radius: 50px;
    padding: 12px 24px;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--accent);
    margin-bottom: 20px;
    animation: badgeGlow 3s ease-in-out infinite;
  }

  .badge-glow {
    position: absolute;
    top: -2px;
    left: -2px;
    right: -2px;
    bottom: -2px;
    background: linear-gradient(45deg, var(--accent), var(--accent-secondary));
    border-radius: inherit;
    opacity: 0;
    z-index: -1;
    transition: opacity 0.3s ease;
  }

  .hero-badge:hover .badge-glow {
    opacity: 0.3;
  }

  @keyframes badgeGlow {
    0%,
    100% {
      box-shadow: 0 0 20px rgba(124, 210, 255, 0.1);
    }
    50% {
      box-shadow:
        0 0 40px rgba(124, 210, 255, 0.2),
        0 0 60px rgba(163, 255, 176, 0.1);
    }
  }

  .hero-image-section {
    position: relative;
    margin: 20px 0;
  }

  .hero-image-container {
    position: relative;
    max-width: 650px;
    margin: 0 auto;
  }

  .image-frame {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.05));
    padding: 8px;
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .hero-image {
    width: 100%;
    height: auto;
    aspect-ratio: 4/3;
    object-fit: cover;
    border-radius: 16px;
    filter: contrast(1.05) brightness(1.02) saturate(1.1);
    transition: all 0.5s ease;
  }

  .image-glow {
    position: absolute;
    top: -20px;
    left: -20px;
    right: -20px;
    bottom: -20px;
    background: radial-gradient(
      ellipse at center,
      rgba(124, 210, 255, 0.15) 0%,
      rgba(163, 255, 176, 0.1) 50%,
      transparent 70%
    );
    border-radius: inherit;
    z-index: -1;
    animation: imageGlow 4s ease-in-out infinite;
  }

  @keyframes imageGlow {
    0%,
    100% {
      transform: scale(1);
      opacity: 0.3;
    }
    50% {
      transform: scale(1.05);
      opacity: 0.6;
    }
  }

  .hero-image-overlay {
    position: absolute;
    top: 8px;
    left: 8px;
    right: 8px;
    bottom: 8px;
    background: linear-gradient(135deg, rgba(124, 210, 255, 0.05) 0%, transparent 50%, rgba(163, 255, 176, 0.05) 100%);
    border-radius: 16px;
    pointer-events: none;
  }

  .image-decorations {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
  }

  .decoration {
    position: absolute;
    width: 60px;
    height: 60px;
    border: 2px solid rgba(124, 210, 255, 0.2);
    border-radius: 50%;
    animation: decorationFloat 6s ease-in-out infinite;
  }

  .decoration-1 {
    top: -30px;
    left: -30px;
    animation-delay: 0s;
  }

  .decoration-2 {
    top: -20px;
    right: -20px;
    width: 40px;
    height: 40px;
    animation-delay: 2s;
  }

  .decoration-3 {
    bottom: -25px;
    left: 50%;
    transform: translateX(-50%);
    width: 50px;
    height: 50px;
    animation-delay: 4s;
  }

  @keyframes decorationFloat {
    0%,
    100% {
      transform: translateY(0) scale(1);
      opacity: 0.2;
    }
    50% {
      transform: translateY(-15px) scale(1.1);
      opacity: 0.4;
    }
  }

  .hero-title {
    font-size: clamp(3rem, 8vw, 5rem);
    font-weight: 800;
    line-height: 0.9;
    margin: 20px 0 15px 0;
    letter-spacing: -0.02em;
  }

  .title-highlight {
    display: block;
    font-size: 0.6em;
    color: var(--accent);
    font-weight: 600;
    margin-bottom: 10px;
    opacity: 0.8;
  }

  .title-main {
    background: linear-gradient(135deg, var(--text) 0%, var(--accent) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: titleShimmer 3s ease-in-out infinite;
  }

  @keyframes titleShimmer {
    0%,
    100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }

  .hero-subtitle-container {
    display: flex;
    align-items: center;
    gap: 20px;
    margin: 20px 0;
    justify-content: center;
  }

  .subtitle-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    max-width: 100px;
  }

  .hero-subtitle {
    font-size: 1.1rem;
    color: var(--text-secondary);
    font-weight: 500;
    white-space: nowrap;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.8;
  }

  .hero-description {
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 650px;
    margin: 25px auto;
  }

  .location-highlight {
    color: var(--accent);
    font-weight: 600;
  }

  .emphasis {
    color: var(--accent-secondary);
    font-weight: 600;
    font-style: italic;
  }

  .hero-cta {
    display: flex;
    gap: 20px;
    justify-content: center;
    margin-top: 35px;
    flex-wrap: wrap;
  }

  .hero-cta-primary {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: linear-gradient(135deg, var(--accent), var(--accent-secondary));
    color: var(--bg);
    padding: 16px 32px;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 600;
    font-size: 1.1rem;
    transition: all 0.4s ease;
    overflow: hidden;
    box-shadow: 0 8px 25px rgba(124, 210, 255, 0.3);
  }

  .hero-cta-primary:hover {
    transform: translateY(-3px) scale(1.05);
    box-shadow: 0 15px 40px rgba(124, 210, 255, 0.4);
    color: var(--bg);
    text-decoration: none;
  }

  .cta-glow {
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
