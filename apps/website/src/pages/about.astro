<script>
  // Import and initialize ShareLinks component
  import { createShareLinks } from '@lukeus/shared-components';

  // Initialize when DOM is ready
  function initPageComponents() {
    // Initialize ShareLinks
    const shareLinks = createShareLinks({
      containerSelector: '.page-share',
      title: 'About Lukeus | Music Producer & Songwriter',
      description:
        'Learn about Lukeus, the indie artist creating experimental music from Portland, OR. From acoustic storytelling to electronic transformation, discover the journey behind the music.',
    });
    shareLinks.init();

    // Dynamically import enhanced image effects to ensure proper TypeScript compilation
    import('../scripts/aboutImageEnhancer.js')
      .then(({ createAboutImageEnhancer }) => {
        // Optimize settings based on screen size and device capabilities
        const isMobile = window.innerWidth <= 768;
        const hasReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        const imageEnhancer = createAboutImageEnhancer({
          parallaxStrength: isMobile ? 0.02 : 0.03,
          glowIntensity: isMobile ? 0.6 : 0.8,
          particleOptions: {
            count: isMobile ? 8 : 15, // More particles for larger image on desktop
            symbols: ['♪', '♫', '♬', '♩', '♭', '♯', '𝅘𝅥𝅮', '𝅘𝅥', '♮', '𝅘𝅥', '𝅘𝅥𝅮'],
            speedRange: [0.1, 0.6],
            opacityRange: [0.1, 0.25],
            sizeRange: [1.4, 2.2],
          },
          enableMouseTracking: !isMobile && !hasReducedMotion,
          enable3DEffect: !isMobile && !hasReducedMotion,
          enableParticles: !hasReducedMotion,
        });

        if (imageEnhancer.init()) {
          console.log('✨ About page image enhancements loaded successfully');
        } else {
          console.warn('⚠️ About page image enhancements failed to initialize');
        }
      })
      .catch(error => {
        console.error('Failed to load about image enhancements:', error);
      });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPageComponents);
  } else {
    initPageComponents();
  }
</script>
