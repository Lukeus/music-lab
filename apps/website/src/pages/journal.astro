  box-shadow: 0 15px 35px rgba(124, 210, 255, 0.15);
  border-color: var(--accent);
}

.journal-card-inner {
  padding: 30px;
}

.journal-head {
  margin-bottom: 20px;
}

.journal-meta {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 16px;
}

.journal-date {
  color: var(--text-secondary);
  font-size: 0.9rem;
  font-weight: 500;
}

