---
// src/pages/journal.astro
import Base from "../layouts/base.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { formatDate, calculateReadingTime, generateExcerpt, createSlug } from "../utils/blog";
import content from "../data/content.json";

// Get journal entries from JSON data
// First try to get MDX entries, but if none exist, use JSON data
let journalEntries: any[] = [];
try {
  journalEntries = await getCollection("journal");
} catch (e) {
  // Content collection might not exist, that's fine
}

// Create entries from JSON data
const jsonEntries = content.creativeJournal.map((entry, index) => ({
  slug: createSlug(entry.title),
  data: {
    title: entry.title,
    date: entry.date,
    tags: entry.tags,
    published: true,
    excerpt: entry.content.slice(0, 200) + "..."
  },
  body: entry.content,
  id: `json-${index}`,
  collection: 'journal' as const
}));

// Use MDX entries if they exist, otherwise use JSON entries
// This prevents duplication
const allEntries = journalEntries.length > 0 ? journalEntries : jsonEntries;
const sortedEntries = allEntries
  .filter((entry: any) => entry.data.published !== false)
  .sort((a: any, b: any) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

// Get unique tags for filtering
const allTags = [...new Set(sortedEntries.flatMap((entry: any) => entry.data.tags || []))];
---

<Base 
  title="Creative Journal | Lukeus Music Lab"
  description="Explore the creative process through studio notes, lyric sketches, and musical reflections. Insights into experimental music creation, songwriting, and sound design."
  keywords="creative journal, music blog, studio notes, songwriting process, music creation, creative process, experimental music, music production insights"
  ogTitle="Creative Journal - Behind the Music"
  ogDescription="Dive into the creative process with studio notes, lyric sketches, and musical reflections from Lukeus Music Lab."
  ogUrl="https://lukeus.app/journal"
  canonicalUrl="https://lukeus.app/journal"
>

<!-- Journal Specific JSON-LD -->
<script type="application/ld+json">
[
  {
    "@context": "https://schema.org",
    "@type": "Blog",
    "@id": "https://lukeus.app/journal#blog",
    "name": "Lukeus Music Lab - Creative Journal",
    "alternateName": "Creative Journal",
    "description": "Insights into the creative process, studio notes, lyric sketches, and musical reflections from experimental music creation.",
    "url": "https://lukeus.app/journal",
    "mainEntityOfPage": "https://lukeus.app/journal",
    "inLanguage": "en-US",
    "dateCreated": "2025-01-01",
    "dateModified": "2025-01-20",
    "author": {
      "@type": "Person",
      "@id": "https://lukeus.com/#person",
      "name": "Lukeus",
      "url": "https://lukeus.com/"
    },
    "publisher": {
      "@type": "Organization",
      "@id": "https://lukeus.app/#organization",
      "name": "Lukeus Music Lab",
      "url": "https://lukeus.app/"
    },
    "image": "https://lukeus.app/assets/images/lukeus-avatar.png",
    "sameAs": [
      "https://lukeus.art/journal"
    ],
    "about": [
      {
        "@type": "Thing",
        "name": "Music Production"
      },
      {
        "@type": "Thing", 
        "name": "Creative Process"
      },
      {
        "@type": "Thing",
        "name": "Songwriting"
      },
      {
        "@type": "Thing",
        "name": "Sound Design"
      }
    ],
    "keywords": "creative journal, music production, songwriting, studio notes, creative process, experimental music",
    "blogPost": {sortedEntries.slice(0, 5).map((entry: any) => ({
      "@type": "BlogPosting",
      "@id": `https://lukeus.app/journal/${entry.slug}`,
      "headline": entry.data.title,
      "description": entry.data.excerpt || generateExcerpt(entry.body),
      "datePublished": entry.data.date,
      "dateModified": entry.data.date,
      "author": {
        "@id": "https://lukeus.com/#person"
      },
      "publisher": {
        "@id": "https://lukeus.app/#organization"
      },
      "mainEntityOfPage": `https://lukeus.app/journal/${entry.slug}`,
      "url": `https://lukeus.app/journal/${entry.slug}`,
      "image": "https://lukeus.app/assets/images/lukeus-avatar.png",
      "articleSection": "Creative Journal",
      "wordCount": calculateReadingTime(entry.body) * 250, // Estimate words
      "timeRequired": `PT${calculateReadingTime(entry.body)}M`,
      "keywords": (entry.data.tags || []).join(", ")
    }))}
  }
]
</script>

<header>
  <div class="container">
    <div class="header-content">
      <span class="logo">Because Music Matters</span>
      <nav class="nav-links">
        <a href="/" class="nav-link">🏠 Home</a>
        <a href="/tools" class="nav-link">🎹 Tools</a>
      </nav>
      <a href="/" class="logo" id="logo-text">Music Lab</a>
    </div>
  </div>
</header>

<section class="journal-hero">
  <div class="container">
    <div class="journal-hero-content">
      <div class="hero-badge">
        <span class="badge-icon">✍️</span>
        <span>Creative Journal</span>
      </div>
      <h1 class="journal-hero-title">Behind the Music</h1>
      <p class="journal-hero-description">
        Dive into the creative process with studio notes, lyric sketches, and reflections on experimental music creation. Where ideas become sound and sound becomes story.
      </p>
      <div class="journal-stats">
        <div class="stat-item">
          <div class="stat-number">{sortedEntries.length}</div>
          <div class="stat-label">Journal Entries</div>
        </div>
        <div class="stat-item">
          <div class="stat-number">{allTags.length}</div>
          <div class="stat-label">Topics Covered</div>
        </div>
        <div class="stat-item">
          <div class="stat-number">{sortedEntries.reduce((acc: number, entry: any) => acc + calculateReadingTime(entry.body), 0)}</div>
          <div class="stat-label">Minutes of Content</div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="journal-content">
  <div class="container">
    <!-- Enhanced Search and Filter Controls -->
    <div class="journal-controls">
      <div class="search-section">
        <div class="search-container">
          <div class="search-icon">🔍</div>
          <input 
            id="journal-search" 
            class="journal-search" 
            type="search" 
            placeholder="Search ideas, lyrics, studio notes..." 
            aria-label="Search journal entries"
            autocomplete="off"
          >
          <div class="search-clear" id="search-clear">×</div>
        </div>
        <div class="search-suggestions" id="search-suggestions"></div>
      </div>
      
      <div class="filter-section">
        <div class="filter-header">
          <span class="filter-title">Filter by Topic</span>
          <span class="filter-count" id="filter-count">{sortedEntries.length} entries</span>
        </div>
        <div class="journal-tags" role="listbox" aria-label="Filter by tag">
          <button class="tag-filter is-active" data-tag="all" aria-pressed="true">
            <span class="tag-icon">🎯</span>
            <span>All Topics</span>
          </button>
          <button class="tag-filter" data-tag="song-idea" aria-pressed="false">
            <span class="tag-icon">🎶</span>
            <span>Song Ideas</span>
          </button>
          <button class="tag-filter" data-tag="lyric-sketch" aria-pressed="false">
            <span class="tag-icon">✍️</span>
            <span>Lyric Sketches</span>
          </button>
          <button class="tag-filter" data-tag="studio-note" aria-pressed="false">
            <span class="tag-icon">🧪</span>
            <span>Studio Notes</span>
          </button>
          <button class="tag-filter" data-tag="reflection" aria-pressed="false">
            <span class="tag-icon">💭</span>
            <span>Reflections</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Sort Options -->
    <div class="sort-controls">
      <div class="sort-section">
        <label for="sort-select" class="sort-label">Sort by:</label>
        <select id="sort-select" class="sort-select">
          <option value="date-desc">Newest First</option>
          <option value="date-asc">Oldest First</option>
          <option value="title-asc">Title A-Z</option>
          <option value="reading-time">Reading Time</option>
        </select>
      </div>
      <div class="view-controls">
        <button class="view-toggle active" data-view="grid" aria-pressed="true" title="Grid View">
          <span>⊞</span>
        </button>
        <button class="view-toggle" data-view="list" aria-pressed="false" title="List View">
          <span>☰</span>
        </button>
      </div>
    </div>

    <!-- Journal Entries Grid -->
    <div class="journal-entries" id="journal-entries" aria-live="polite">
      {allEntries.map((entry: any) => (
        <article 
          class="journal-card" 
          data-tags={(entry.data.tags || []).join(" ")}
          data-date={entry.data.date}
          data-reading-time={calculateReadingTime(entry.body)}
          data-title={entry.data.title.toLowerCase()}
        >
          <div class="journal-card-inner">
            <header class="journal-head">
              <div class="journal-meta">
                <time class="journal-date" datetime={entry.data.date}>
                  {formatDate(entry.data.date)}
                </time>
                <span class="journal-reading-time">
                  <span class="time-icon">⏱️</span>
                  {calculateReadingTime(entry.body)} min read
                </span>
              </div>
              
              <div class="journal-tags-display">
                {(entry.data.tags || []).map((tag: string) => (
                  <span class="journal-tag" data-tag={tag}>
                    {tag === "song-idea" && <span class="tag-emoji">🎶</span>}
                    {tag === "lyric-sketch" && <span class="tag-emoji">✍️</span>}
                    {tag === "studio-note" && <span class="tag-emoji">🧪</span>}
                    {tag === "reflection" && <span class="tag-emoji">💭</span>}
                    {!['song-idea', 'lyric-sketch', 'studio-note', 'reflection'].includes(tag) && 
                      <span class="tag-emoji">#</span>}
                    <span class="tag-text">{tag.replace('-', ' ')}</span>
                  </span>
                ))}
              </div>
              
              <h3 class="journal-title">
                <a href={`/journal/${entry.slug}`} class="journal-title-link">
                  {entry.data.title}
                </a>
              </h3>
            </header>

            <div class="journal-body">
              <p class="journal-snippet">
                {entry.data.excerpt || generateExcerpt(entry.body)}
              </p>
              <div class="journal-footer">
                <a 
                  href={`/journal/${entry.slug}`} 
                  class="read-more" 
                  aria-label={`Read full post: ${entry.data.title}`}
                >
                  <span>Read Full Entry</span>
                  <span class="arrow">→</span>
                </a>
                <div class="journal-engagement">
                  <button class="like-btn" data-entry={entry.slug} title="Like this entry">
                    <span class="heart">♡</span>
                  </button>
                </div>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Load More / Pagination -->
    <div class="journal-pagination">
      <button class="load-more-btn" id="load-more" style="display: none;">
        <span class="load-text">Load More Entries</span>
        <span class="load-icon">↓</span>
      </button>
    </div>

    <!-- Empty State -->
    <div class="journal-empty" id="empty-state" style="display: none;">
      <div class="empty-icon">📝</div>
      <h3>No entries found</h3>
      <p>Try adjusting your search or filter criteria.</p>
      <button class="reset-filters-btn" id="reset-filters">Clear All Filters</button>
    </div>
  </div>
</section>

<footer>
  <div class="container">
    <div class="social-links">
      <a href="https://open.spotify.com/artist/3NckmpFR1r92wBscpnbVXl?si=pNvmFrLvTFGIBu0KTAYlqQ" class="social-link" target="_blank" rel="noopener" aria-label="Open Lukeus on Spotify">Spotify</a>
      <a href="https://soundcloud.com/lukeusmusic" class="social-link" target="_blank" rel="noopener" aria-label="Open Lukeus on SoundCloud">SoundCloud</a>
      <a href="https://www.instagram.com/musiclukeus/" class="social-link" target="_blank" rel="noopener" aria-label="Open Lukeus on Instagram">Instagram</a>
    </div>
    <p>&copy; 2025 Lukeus. All reflections are works in progress.</p>
  </div>
</footer>
</Base>

<style>
