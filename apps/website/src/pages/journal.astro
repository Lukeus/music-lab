  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: 20px;
}

.journal-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.read-more {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: linear-gradient(135deg, var(--accent), var(--accent-secondary));
  color: var(--bg);
