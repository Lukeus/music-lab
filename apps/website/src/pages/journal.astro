  border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
  border-radius: 999px;
  font-size: 0.8rem;
  font-weight: 500;
  color: var(--accent);
}

.tag-emoji {
  font-size: 0.9rem;
}

.tag-text {
  text-transform: capitalize;
}

.journal-title {
  margin: 0;
  font-weight: 700;
