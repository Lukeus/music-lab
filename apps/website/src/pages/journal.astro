  padding: 8px 12px;
  border: 1px solid var(--border);
  border-radius: 8px;
  background: var(--bg);
  color: var(--text);
  cursor: pointer;
}

.view-controls {
  display: flex;
  gap: 8px;
}

.view-toggle {
  padding: 10px 12px;
  border: 2px solid var(--border);
  background: var(--bg-secondary);
  color: var(--text-secondary);
  border-radius: 8px;
  cursor: pointer;
  transition: all 0.3s ease;
  font-size: 1.1rem;
}

.view-toggle:hover,
.view-toggle.active {
  border-color: var(--accent);
  color: var(--accent);
}

.journal-entries {
  display: grid;
  gap: 30px;
  grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
  margin-bottom: 50px;
}

.journal-entries.list-view {
  grid-template-columns: 1fr;
}

.journal-entries.list-view .journal-card {
  display: flex;
  padding: 20px;
}

.journal-entries.list-view .journal-head {
  flex: 0 0 200px;
  margin-right: 30px;
}

.journal-entries.list-view .journal-body {
  flex: 1;
}

.journal-card {
  background: var(--bg-secondary);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 0;
  transition: all 0.4s ease;
  position: relative;
  overflow: hidden;
  cursor: pointer;
}

.journal-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4px;
  background: linear-gradient(135deg, var(--accent), var(--accent-secondary));
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.3s ease;
