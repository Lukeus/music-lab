  background: #ff6b9d;
  border-color: #ff6b9d;
  color: white;
}

.like-btn.liked .heart {
  content: '♥';
}

.journal-pagination {
  text-align: center;
  margin-top: 50px;
}

.load-more-btn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 14px 24px;
  background: var(--bg-secondary);
  border: 2px solid var(--border);
  border-radius: 12px;
  color: var(--text);
  cursor: pointer;
  font-weight: 600;
  transition: all 0.3s ease;
}

.load-more-btn:hover {
  border-color: var(--accent);
  color: var(--accent);
  transform: translateY(-2px);
}

.load-icon {
  font-size: 1.2rem;
  transition: transform 0.3s ease;
}

.load-more-btn:hover .load-icon {
  transform: translateY(2px);
}

.journal-empty {
  text-align: center;
  padding: 80px 20px;
  color: var(--text-secondary);
}

.empty-icon {
  font-size: 4rem;
  margin-bottom: 20px;
}

.journal-empty h3 {
  font-size: 1.5rem;
  color: var(--text);
  margin-bottom: 12px;
}

.reset-filters-btn {
  margin-top: 20px;
  padding: 12px 20px;
  background: linear-gradient(135deg, var(--accent), var(--accent-secondary));
  color: var(--bg);
  border: none;
  border-radius: 8px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
}

.reset-filters-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 15px rgba(124, 210, 255, 0.3);
}

/* Responsive Design */
@media (max-width: 768px) {
  .journal-hero {
    padding: 60px 0 50px 0;
  }
  
  .journal-stats {
    gap: 20px;
  }
  
  .sort-controls {
    flex-direction: column;
    gap: 16px;
    text-align: center;
  }
  
  .journal-entries {
    grid-template-columns: 1fr;
    gap: 20px;
  }
  
  .journal-card-inner {
    padding: 20px;
  }
  
  .journal-footer {
    flex-direction: column;
    gap: 12px;
    align-items: stretch;
  }
}

/* Animation for entries appearing */
.journal-card {
  opacity: 0;
  transform: translateY(20px);
  animation: fadeInUp 0.6s ease forwards;
}

.journal-card:nth-child(1) { animation-delay: 0.1s; }
.journal-card:nth-child(2) { animation-delay: 0.2s; }
.journal-card:nth-child(3) { animation-delay: 0.3s; }
.journal-card:nth-child(4) { animation-delay: 0.4s; }
.journal-card:nth-child(5) { animation-delay: 0.5s; }
.journal-card:nth-child(6) { animation-delay: 0.6s; }

@keyframes fadeInUp {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
</style>

<script>
// Enhanced Journal Page Interactions
import { bindJournalFeatures } from '../scripts/journal';

document.addEventListener('DOMContentLoaded', () => {
  bindJournalFeatures();
  initJournalPage();
});

function initJournalPage(): void {
  const searchInput = document.getElementById('journal-search') as HTMLInputElement;
  const searchClear = document.getElementById('search-clear') as HTMLElement;
  const tagFilters = document.querySelectorAll('.tag-filter');
  const sortSelect = document.getElementById('sort-select') as HTMLSelectElement;
  const viewToggles = document.querySelectorAll('.view-toggle');
  const journalEntries = document.getElementById('journal-entries') as HTMLElement;
  const filterCount = document.getElementById('filter-count') as HTMLElement;
  const emptyState = document.getElementById('empty-state') as HTMLElement;
  const resetFilters = document.getElementById('reset-filters') as HTMLElement;
  const likeButtons = document.querySelectorAll('.like-btn');

  let currentFilters = { tag: 'all', search: '', sort: 'date-desc', view: 'grid' };
  let allCards = Array.from(document.querySelectorAll('.journal-card')) as HTMLElement[];

  // Search functionality with real-time filtering
  searchInput?.addEventListener('input', (e) => {
    const query = (e.target as HTMLInputElement).value.toLowerCase();
    currentFilters.search = query;
    
    if (query.length > 0) {
      searchClear?.classList.add('visible');
    } else {
      searchClear?.classList.remove('visible');
    }
    
    filterAndSort();
  });

  // Clear search
  searchClear?.addEventListener('click', () => {
    searchInput.value = '';
    currentFilters.search = '';
    searchClear.classList.remove('visible');
    filterAndSort();
  });

  // Tag filtering
  tagFilters.forEach(filter => {
    filter.addEventListener('click', () => {
      // Remove active from all
      tagFilters.forEach(f => {
        f.classList.remove('is-active');
        f.setAttribute('aria-pressed', 'false');
      });
      
      // Add active to clicked
      filter.classList.add('is-active');
      filter.setAttribute('aria-pressed', 'true');
      
      currentFilters.tag = filter.getAttribute('data-tag') || 'all';
      filterAndSort();
    });
  });

  // Sort functionality
  sortSelect?.addEventListener('change', (e) => {
    currentFilters.sort = (e.target as HTMLSelectElement).value;
    filterAndSort();
  });

  // View toggle
  viewToggles.forEach(toggle => {
    toggle.addEventListener('click', () => {
      viewToggles.forEach(t => {
        t.classList.remove('active');
        t.setAttribute('aria-pressed', 'false');
      });
      
      toggle.classList.add('active');
      toggle.setAttribute('aria-pressed', 'true');
      
      const view = toggle.getAttribute('data-view');
      currentFilters.view = view || 'grid';
      
      if (view === 'list') {
        journalEntries?.classList.add('list-view');
      } else {
        journalEntries?.classList.remove('list-view');
      }
    });
  });

  // Like functionality
  likeButtons.forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      
      btn.classList.toggle('liked');
      
      // Add heart animation
      const heart = btn.querySelector('.heart') as HTMLElement;
      if (heart) {
        heart.style.animation = 'heartBeat 0.6s ease';
        setTimeout(() => {
          heart.style.animation = '';
        }, 600);
      }
    });
  });

  // Reset filters
  resetFilters?.addEventListener('click', () => {
    searchInput.value = '';
    currentFilters = { tag: 'all', search: '', sort: 'date-desc', view: 'grid' };
    
    // Reset UI
    searchClear?.classList.remove('visible');
    tagFilters.forEach(f => {
      f.classList.remove('is-active');
      f.setAttribute('aria-pressed', 'false');
    });
    document.querySelector('[data-tag="all"]')?.classList.add('is-active');
    document.querySelector('[data-tag="all"]')?.setAttribute('aria-pressed', 'true');
    
    sortSelect.value = 'date-desc';
    journalEntries?.classList.remove('list-view');
    
    filterAndSort();
  });

  function filterAndSort(): void {
    let visibleCards = allCards.filter(card => {
      // Tag filter
      const cardTags = card.getAttribute('data-tags') || '';
      const tagMatch = currentFilters.tag === 'all' || cardTags.includes(currentFilters.tag);
      
      // Search filter
      const cardTitle = card.getAttribute('data-title') || '';
      const cardSnippet = card.querySelector('.journal-snippet')?.textContent?.toLowerCase() || '';
      const searchMatch = currentFilters.search === '' || 
        cardTitle.includes(currentFilters.search) || 
        cardSnippet.includes(currentFilters.search);
      
      return tagMatch && searchMatch;
    });

    // Sort
    visibleCards.sort((a, b) => {
      switch (currentFilters.sort) {
        case 'date-desc':
          return new Date(b.getAttribute('data-date') || '').getTime() - 
                 new Date(a.getAttribute('data-date') || '').getTime();
        case 'date-asc':
          return new Date(a.getAttribute('data-date') || '').getTime() - 
                 new Date(b.getAttribute('data-date') || '').getTime();
        case 'title-asc':
          return (a.getAttribute('data-title') || '').localeCompare(b.getAttribute('data-title') || '');
        case 'reading-time':
          return parseInt(a.getAttribute('data-reading-time') || '0') - 
                 parseInt(b.getAttribute('data-reading-time') || '0');
        default:
          return 0;
      }
    });

    // Hide all cards first
    allCards.forEach(card => card.style.display = 'none');
    
    // Show filtered cards
    if (visibleCards.length > 0) {
      visibleCards.forEach((card, index) => {
        card.style.display = 'block';
        card.style.animationDelay = `${index * 0.1}s`;
      });
      emptyState.style.display = 'none';
    } else {
      emptyState.style.display = 'block';
    }
    
    // Update count
    if (filterCount) {
      filterCount.textContent = `${visibleCards.length} ${visibleCards.length === 1 ? 'entry' : 'entries'}`;
    }
  }

  // Initialize
  filterAndSort();
}

// Add heart beat animation
const style = document.createElement('style');
style.textContent = `
  @keyframes heartBeat {
    0%, 100% { transform: scale(1); }
    25% { transform: scale(1.3); }
    50% { transform: scale(1.1); }
    75% { transform: scale(1.2); }
  }
`;
document.head.appendChild(style);
</script>
