{
  "name": "lukeus-music-lab",
  "version": "1.0.0",
  "description": "Lukeus Music Lab - Experimental Sound & Creative Process website",
  "main": "index.html",
  "scripts": {
    "start": "npx serve .",
    "dev": "npx live-server --port=3000 --open=/",
    "build": "echo 'Static site - no build process needed'",
    "lint": "npx eslint js/ --fix",
    "format": "npx prettier --write '**/*.{html,css,js,md}'",
    "deploy": "echo 'Deploy with: git push origin main - GitHub Pages will handle the rest!'"
  },
  "keywords": [
    "music",
    "experimental",
    "sound",
    "creative",
    "portfolio",
    "website",
    "github-pages"
  ],
  "author": "Lukeus",
  "license": "MIT",
  "devDependencies": {
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "live-server": "^1.2.2",
    "serve": "^14.2.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lukeus/music-lab.git"
  },
  "homepage": "https://lukeus.github.io/music-lab"
}
