---
import "../styles/components.css";
---

<div class="audio-ui">
  <button class="play" data-audio="/audio/WhatYouWant.mp3" data-state="paused" aria-label="Play/Pause">▶</button>
  <canvas class="waveform-canvas" width="180" height="32" style="vertical-align:middle;display:inline-block;"></canvas>
</div>
<script type="module">
  import { bindPlayButtons, bindWaveform } from "../scripts/audio.ts";
  window.addEventListener("DOMContentLoaded", () => {
    bindPlayButtons();
    bindWaveform();
  });
</script>
