---
import Base from './base.astro';
import { formatDate, calculateReadingTime } from '../utils/blog';

interface Props {
  frontmatter: {
    title: string;
    date: string;
    excerpt?: string;
    tags?: string[];
    categories?: string[];
    featuredImage?: string;
    author?: string;
  };
  content: string;
}

const { frontmatter, content } = Astro.props;
const readingTime = calculateReadingTime(content);
const formattedDate = formatDate(frontmatter.date);
---

<Base title={`${frontmatter.title} - Lukeus Music Lab`} description={frontmatter.excerpt}>
  <article class="blog-post">
    <header class="blog-post-header">
      <div class="container">
        <nav class="blog-breadcrumb" aria-label="Breadcrumb">
          <a href="/" class="breadcrumb-link">Home</a>
          <span class="breadcrumb-separator" aria-hidden="true">→</span>
          <a href="/#journal" class="breadcrumb-link">Journal</a>
          <span class="breadcrumb-separator" aria-hidden="true">→</span>
          <span class="breadcrumb-current">{frontmatter.title}</span>
        </nav>

        {frontmatter.featuredImage && (
          <div class="featured-image">
            <img src={frontmatter.featuredImage} alt={frontmatter.title} />
          </div>
        )}

        <div class="post-meta">
          <time class="post-date" datetime={frontmatter.date}>
            {formattedDate}
          </time>
          <span class="post-reading-time" aria-label={`Estimated reading time: ${readingTime} minutes`}>
            ⏱️ {readingTime} min read
          </span>
          <span class="post-author">by {frontmatter.author || 'Lukeus'}</span>
        </div>

        <h1 class="post-title">{frontmatter.title}</h1>
        
        {frontmatter.excerpt && (
          <p class="post-excerpt">{frontmatter.excerpt}</p>
        )}

        {(frontmatter.tags && frontmatter.tags.length > 0) && (
          <div class="post-tags" role="list" aria-label="Post tags">
            {frontmatter.tags.map(tag => (
              <span class="post-tag" role="listitem">
                {tag === 'song-idea' && '🎶 Song Idea'}
                {tag === 'lyric-sketch' && '✍️ Lyric Sketch'}
                {tag === 'studio-note' && '🧪 Studio Note'}
                {!['song-idea', 'lyric-sketch', 'studio-note'].includes(tag) && `#${tag}`}
              </span>
            ))}
          </div>
        )}
      </div>
    </header>

    <div class="blog-post-content">
      <div class="container">
        <div class="prose">
          <slot />
        </div>
      </div>
    </div>

    <footer class="blog-post-footer">
      <div class="container">
        <div class="post-navigation">
          <a href="/#journal" class="back-to-journal">
            ← Back to Journal
          </a>
        </div>
        
        <div class="post-share">
          <h3>Share this post</h3>
          <div class="share-buttons">
            <button class="share-button" onclick="sharePost()">
              📤 Share
            </button>
            <button class="share-button" onclick="copyUrl()">
              🔗 Copy Link
            </button>
          </div>
        </div>
      </div>
    </footer>
  </article>
</Base>

<script>
  function sharePost() {
    if (navigator.share) {
      navigator.share({
        title: document.title,
        url: window.location.href
      });
    } else {
      copyUrl();
    }
  }

  function copyUrl() {
    navigator.clipboard.writeText(window.location.href).then(() => {
      // Simple feedback - could be enhanced with a toast notification
      const button = document.querySelector('.share-button:nth-child(2)');
      if (button) {
        const originalText = button.textContent;
        button.textContent = '✅ Copied!';
        setTimeout(() => {
          button.textContent = originalText;
        }, 2000);
      }
    });
  }
</script>

<style>
/* Smooth scrolling for the whole page */
html {
  scroll-behavior: smooth;
}

.blog-post {
  min-height: 100vh;
  background: var(--bg);
  color: var(--text);
  /* Account for sticky header */
  padding-top: 80px;
  margin-top: -80px;
}

.blog-post-header {
  padding: 80px 0 60px 0;
  border-bottom: 1px solid var(--border);
  background: linear-gradient(135deg, 
    rgba(124, 210, 255, 0.05) 0%, 
    rgba(163, 255, 176, 0.05) 100%);
}

.blog-breadcrumb {
  margin-bottom: 32px;
  font-size: 0.9rem;
  color: var(--text-secondary);
}

.breadcrumb-link {
  color: var(--accent);
  text-decoration: none;
  transition: color 0.3s ease;
}

.breadcrumb-link:hover {
  color: var(--accent-secondary);
}

.breadcrumb-separator {
  margin: 0 12px;
  opacity: 0.5;
}

.breadcrumb-current {
  color: var(--text);
}

.featured-image {
  margin-bottom: 32px;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: var(--shadow-1);
}

.featured-image img {
  width: 100%;
  height: 300px;
  object-fit: cover;
}

.post-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  margin-bottom: 24px;
  font-size: 0.9rem;
  color: var(--text-secondary);
}

.post-date, .post-reading-time, .post-author {
  display: flex;
  align-items: center;
  gap: 6px;
}

.post-title {
  font-size: clamp(2rem, 4vw, 3.5rem);
  font-weight: 700;
  line-height: 1.1;
  margin-bottom: 20px;
  background: linear-gradient(135deg, var(--accent), var(--accent-secondary));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.post-excerpt {
  font-size: 1.2rem;
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: 24px;
  font-style: italic;
}

.post-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.post-tag {
  background: rgba(124, 210, 255, 0.1);
  color: var(--accent);
  padding: 6px 12px;
  border-radius: 20px;
  font-size: 0.85rem;
  border: 1px solid rgba(124, 210, 255, 0.2);
}

.blog-post-content {
  padding: 60px 0;
}

.prose {
  max-width: 70ch;
  margin: 0 auto;
  line-height: 1.7;
  font-size: 1.1rem;
}

.prose h1, .prose h2, .prose h3, .prose h4, .prose h5, .prose h6 {
  font-weight: 600;
  line-height: 1.3;
  margin: 2em 0 1em 0;
  color: var(--text);
  /* Account for sticky header when linking to headings */
  scroll-margin-top: 100px;
}

.prose h1 { font-size: 2.25rem; }
.prose h2 { font-size: 1.875rem; }
.prose h3 { font-size: 1.5rem; }
.prose h4 { font-size: 1.25rem; }

.prose p {
  margin: 1.5em 0;
  color: var(--text);
}

.prose blockquote {
  border-left: 4px solid var(--accent);
  padding-left: 20px;
  margin: 2em 0;
  font-style: italic;
  background: rgba(124, 210, 255, 0.05);
  padding: 20px;
  border-radius: 8px;
}

.prose code {
  background: var(--bg-secondary);
  padding: 2px 6px;
  border-radius: 4px;
  font-family: 'Fira Code', monospace;
  font-size: 0.9em;
}

.prose pre {
  background: var(--bg-secondary);
  padding: 20px;
  border-radius: 8px;
  overflow-x: auto;
  border: 1px solid var(--border);
}

.prose pre code {
  background: none;
  padding: 0;
}

.prose a {
  color: var(--accent);
  text-decoration: underline;
  text-decoration-thickness: 2px;
  text-underline-offset: 3px;
  transition: color 0.3s ease;
}

.prose a:hover {
  color: var(--accent-secondary);
}

.prose ul, .prose ol {
  margin: 1.5em 0;
  padding-left: 1.5em;
}

.prose li {
  margin: 0.5em 0;
}

.blog-post-footer {
  padding: 60px 0;
  border-top: 1px solid var(--border);
  background: var(--bg-secondary);
}

.post-navigation {
  margin-bottom: 40px;
}

.back-to-journal {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--accent);
  text-decoration: none;
  font-weight: 500;
  transition: all 0.3s ease;
}

.back-to-journal:hover {
  color: var(--accent-secondary);
  transform: translateX(-4px);
}

.post-share h3 {
  margin-bottom: 16px;
  color: var(--text);
}

.share-buttons {
  display: flex;
  gap: 12px;
}

.share-button {
  background: var(--bg);
  color: var(--text);
  border: 1px solid var(--border);
  padding: 10px 16px;
  border-radius: 8px;
  cursor: pointer;
  transition: all 0.3s ease;
}

.share-button:hover {
  background: var(--accent);
  color: var(--bg);
  border-color: var(--accent);
}

@media (max-width: 768px) {
  .blog-post {
    /* Adjust for smaller header on mobile */
    padding-top: 70px;
    margin-top: -70px;
  }
  
  .blog-post-header {
    padding: 70px 0 40px 0;
  }
  
  .post-meta {
    flex-direction: column;
    gap: 8px;
  }
  
  .prose {
    font-size: 1rem;
    padding: 0 20px; /* Add some horizontal padding on mobile */
  }
  
  .share-buttons {
    flex-direction: column;
  }
  
  .blog-breadcrumb {
    font-size: 0.8rem;
  }
  
  .post-title {
    font-size: clamp(1.5rem, 8vw, 2.5rem);
  }
}
</style>
